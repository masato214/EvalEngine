# ============================================================
# EvalEngine - Environment Variables
# Copy to .env and fill in values
# ============================================================

# Database
DATABASE_URL=postgresql://eval:eval@localhost:5432/evalengine

# Redis

# JWT
JWT_SECRET=change-me-32-chars-minimum-secret
JWT_REFRESH_SECRET=change-me-32-chars-refresh-secret
JWT_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Internal service communication (NestJS → FastAPI)
AI_SERVICE_URL=http://localhost:8000
AI_INTERNAL_KEY=change-me-internal-key-16-chars

# OpenAI
OPENAI_API_KEY=sk-your-openai-api-key
EMBEDDING_MODEL=text-embedding-3-small

# Next.js Admin Panel
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXTAUTH_SECRET=change-me-nextauth-secret
NEXTAUTH_URL=http://localhost:3000

# Ports
API_PORT=3001
AI_PORT=8000
WEB_PORT=3000
